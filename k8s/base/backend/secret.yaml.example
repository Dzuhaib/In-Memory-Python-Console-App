# EXAMPLE ONLY - Do not commit actual secrets!
# Create the secret using kubectl:
#   kubectl create secret generic backend-secrets \
#     --namespace todo-app \
#     --from-literal=DATABASE_URL='postgresql://user:password@host:5432/dbname?sslmode=require' \
#     --from-literal=OPENAI_API_KEY='sk-your-openai-api-key-here'
#
# Or apply this file after replacing the base64 values:
#   echo -n 'your-actual-value' | base64
#   kubectl apply -f secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: todo-app
  labels:
    app: todo-app
    component: backend
type: Opaque
data:
  # Base64 encoded values - replace with your actual values
  # echo -n 'postgresql://user:password@host:5432/dbname?sslmode=require' | base64
  DATABASE_URL: cG9zdGdyZXNxbDovL3VzZXI6cGFzc3dvcmRAaG9zdDo1NDMyL2RibmFtZT9zc2xtb2RlPXJlcXVpcmU=
  # echo -n 'sk-your-openai-api-key-here' | base64
  OPENAI_API_KEY: c2steW91ci1vcGVuYWktYXBpLWtleS1oZXJl
