# API URL for the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# OpenAI API Key for AI chatbot feature (optional - backend handles API calls)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Better Auth - Database URL (same Neon PostgreSQL as backend)
DATABASE_URL=postgresql://user:password@host/dbname

# Better Auth - Secret for signing sessions (min 32 chars, generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-random-secret-min-32-chars-here

# Better Auth - Base URL for auth callbacks
BETTER_AUTH_URL=http://localhost:3000