# Database connection (PostgreSQL - Railway will auto-inject DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Server configuration (Railway sets PORT automatically)
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins - update for production)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.railway.app
